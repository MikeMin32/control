# Database (local docker-run / host tooling)
DATABASE_URL=postgresql://vmcontrol:vmcontrol@127.0.0.1:5434/vmcontrol

# Compose Postgres (required for `docker compose up`)
POSTGRES_USER=vmcontrol
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=vmcontrol

# Auth — use a long random string in production (required by compose)
SESSION_SECRET=change-me-to-a-long-random-secret

# Public URL used for origin checks (must match how users reach the app)
APP_URL=http://127.0.0.1:3001

# Optional read-only Proxmox (leave unset / false for “Not configured”)
PROXMOX_ENABLED=false
PROXMOX_HOST=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Set true only when using a private CA / lab without trusted certs
PROXMOX_TLS_INSECURE=false
PROXMOX_TIMEOUT_MS=8000

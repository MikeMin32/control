{
  "name": "vm-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 -H 127.0.0.1",
    "build": "NEXT_DIST_DIR=${NEXT_DIST_DIR:-.next-build} node scripts/assert-dev-not-using-next-dir.mjs && prisma generate && NEXT_DIST_DIR=${NEXT_DIST_DIR:-.next-build} next build",
    "start": "NEXT_DIST_DIR=${NEXT_DIST_DIR:-.next-build} next start -p ${PORT:-3001} -H ${HOST:-127.0.0.1}",
    "start:prod": "NEXT_DIST_DIR=${NEXT_DIST_DIR:-.next} next start -p ${PORT:-3000} -H ${HOST:-0.0.0.0}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://vmcontrol:vmcontrol@127.0.0.1:5434/vmcontrol_test} DATABASE_URL=${TEST_DATABASE_URL:-postgresql://vmcontrol:vmcontrol@127.0.0.1:5434/vmcontrol_test} vitest run",
    "test:watch": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://vmcontrol:vmcontrol@127.0.0.1:5434/vmcontrol_test} DATABASE_URL=${TEST_DATABASE_URL:-postgresql://vmcontrol:vmcontrol@127.0.0.1:5434/vmcontrol_test} vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.67.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8",
    "prisma": "^6.19.0",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
